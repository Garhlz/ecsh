{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}\"']*$|\\[[^\\]\"']*$|\\([^)\"']*$",
    "decreaseIndentPattern": "^\\s*[}\\]\\)]"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:let\\s+[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[^\\]]+\\])*)\\s*=\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^.*\\|>\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
